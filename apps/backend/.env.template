# Set your own development URL. There is intentionally no shared password.
# Format: postgres://ember:<URL_ENCODED_PASSWORD>@127.0.0.1:5432/ember
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Storefront, admin, and auth callers. Separate multiple origins with commas.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Replace both values before any shared or production deployment.
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters

MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# Real accounts are the default. Local fixture impersonation requires all three
# settings in both apps: EMBER_AUTH_MODE=local, EMBER_LOCAL_DATA_ACCESS=true,
# and the same private EMBER_LOCAL_API_KEY (at least 32 random characters).
EMBER_AUTH_MODE=accounts

# Stripe remains disabled until both values are supplied.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
