{
  "name": "@ember/backend",
  "private": true,
  "version": "0.1.0",
  "description": "EMBER commerce and reverse-marketplace API",
  "scripts": {
    "build": "medusa build --no-lint",
    "dev": "medusa develop",
    "start": "medusa start",
    "db:generate": "medusa db:generate emberMarketplace",
    "db:migrate": "medusa db:migrate",
    "db:setup": "medusa db:setup",
    "seed:marketplace": "medusa exec ./src/scripts/seed-marketplace.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.20.1",
    "@medusajs/admin-shared": "2.20.1",
    "@medusajs/caching": "2.20.1",
    "@medusajs/cli": "2.20.1",
    "@medusajs/dashboard": "2.20.1",
    "@medusajs/draft-order": "2.20.1",
    "@medusajs/framework": "2.20.1",
    "@medusajs/medusa": "2.20.1",
    "@medusajs/ui": "4.2.3",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.7.28",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
