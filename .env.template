# Storefront defaults to its safe in-process demo adapters.
NEXT_PUBLIC_EMBER_DATA_MODE=demo
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Copy this template into apps/storefront/.env.local, not the repository root.
# Persistent mode is still being integrated. These values are SERVER-ONLY.
# EMBER_DATA_MODE=medusa
# MEDUSA_BACKEND_URL=http://127.0.0.1:9000
# Local development bridge only; never enable on a public deployment.
# EMBER_LOCAL_DATA_ACCESS=true
# EMBER_LOCAL_API_KEY=generate-at-least-32-random-characters
